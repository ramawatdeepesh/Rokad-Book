{
  "entities": {
    "ShopProfile": {
      "title": "ShopProfile",
      "description": "Merchant shop profile, opening cash balance, custom categories, and display preferences for a Google-authenticated user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the shop owner.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google account email address.",
          "maxLength": 200
        },
        "shopName": {
          "type": "string",
          "description": "Registered or trading name of the merchant shop.",
          "minLength": 1,
          "maxLength": 120
        },
        "proprietorName": {
          "type": "string",
          "description": "Full name of the shop owner or proprietor.",
          "minLength": 1,
          "maxLength": 100
        },
        "businessType": {
          "type": "string",
          "description": "Retail trade category of the business.",
          "enum": [
            "Kirana & Provision",
            "Jewellery & Bullion",
            "Sweets & Dairy",
            "Textiles & Garments",
            "Hardware & Paints"
          ]
        },
        "phone": {
          "type": "string",
          "description": "Primary 10-digit Indian mobile number.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{10}$"
        },
        "gstin": {
          "type": "string",
          "description": "Optional Indian GST Identification Number.",
          "maxLength": 20
        },
        "address": {
          "type": "string",
          "description": "Physical shop address.",
          "maxLength": 240
        },
        "openingCashBalance": {
          "type": "number",
          "description": "Base opening cash balance in INR prior to logged entries."
        },
        "customCategories": {
          "type": "array",
          "description": "User-defined custom ledger categories (max 25 items, each 1-40 chars)."
        },
        "showBilingualTerms": {
          "type": "boolean",
          "description": "Whether to display bilingual Hindi mercantile cues."
        },
        "showNumericKeypad": {
          "type": "boolean",
          "description": "Whether to display the tactile numeric keypad in entry modals."
        },
        "showPaiseDecimals": {
          "type": "boolean",
          "description": "Whether to always format amounts with two decimal places."
        },
        "profileCompleted": {
          "type": "boolean",
          "description": "Flag indicating the user completed post-login profile setup."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the shop profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the shop profile was last updated."
        }
      },
      "required": [
        "uid",
        "email",
        "shopName",
        "proprietorName",
        "businessType",
        "phone",
        "gstin",
        "address",
        "openingCashBalance",
        "customCategories",
        "showBilingualTerms",
        "showNumericKeypad",
        "showPaiseDecimals",
        "profileCompleted",
        "createdAt",
        "updatedAt"
      ]
    },
    "Party": {
      "title": "Party",
      "description": "Customer or supplier Udhaar khata account belonging to a merchant.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the owning merchant.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Name of the customer or wholesaler party.",
          "minLength": 1,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "description": "Optional 10-digit contact phone number (empty string or 10 digits).",
          "maxLength": 10,
          "pattern": "^([0-9]{10})?$"
        },
        "role": {
          "type": "string",
          "description": "Relationship role of the party.",
          "enum": ["customer", "supplier"]
        },
        "address": {
          "type": "string",
          "description": "Optional area or address of the party.",
          "maxLength": 240
        },
        "openingBalance": {
          "type": "number",
          "description": "Opening credit balance in INR (+ receivable, - payable)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the party account was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the party account was last updated."
        }
      },
      "required": [
        "ownerId",
        "name",
        "phone",
        "role",
        "address",
        "openingBalance",
        "createdAt",
        "updatedAt"
      ]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Daily mercantile cashbook or khata credit transaction entry.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the owning merchant.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "direction": {
          "type": "string",
          "description": "Cash inflow or outflow direction.",
          "enum": ["in", "out"]
        },
        "amount": {
          "type": "number",
          "description": "Positive monetary value in INR."
        },
        "paymentMode": {
          "type": "string",
          "description": "Settlement channel.",
          "enum": ["Cash", "UPI", "Khata"]
        },
        "partyId": {
          "type": "string",
          "description": "Optional linked Party document ID (empty string if walk-in).",
          "maxLength": 128
        },
        "partyName": {
          "type": "string",
          "description": "Display name of the counterparty.",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "description": "Default or user-defined mercantile ledger category.",
          "minLength": 1,
          "maxLength": 40
        },
        "note": {
          "type": "string",
          "description": "Optional item remarks or UPI reference.",
          "maxLength": 280
        },
        "billNo": {
          "type": "string",
          "description": "Optional invoice or bill reference number.",
          "maxLength": 40
        },
        "date": {
          "type": "string",
          "description": "Local ledger date in YYYY-MM-DD format.",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "time": {
          "type": "string",
          "description": "Local ledger time in HH:mm 24-hour format.",
          "maxLength": 5,
          "pattern": "^[0-9]{2}:[0-9]{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated."
        }
      },
      "required": [
        "ownerId",
        "direction",
        "amount",
        "paymentMode",
        "partyId",
        "partyName",
        "category",
        "note",
        "billNo",
        "date",
        "time",
        "createdAt",
        "updatedAt"
      ]
    },
    "CashDrawer": {
      "title": "CashDrawer",
      "description": "Physical currency note counts for daily Galla reconciliation.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the owning merchant.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "n500": { "type": "number", "description": "Count of ₹500 notes" },
        "n200": { "type": "number", "description": "Count of ₹200 notes" },
        "n100": { "type": "number", "description": "Count of ₹100 notes" },
        "n50": { "type": "number", "description": "Count of ₹50 notes" },
        "n20": { "type": "number", "description": "Count of ₹20 notes" },
        "n10": { "type": "number", "description": "Count of ₹10 notes" },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated."
        }
      },
      "required": [
        "ownerId",
        "n500",
        "n200",
        "n100",
        "n50",
        "n20",
        "n10",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/ShopProfile" },
      "description": "Private shop profile, PII, custom categories, and ledger preferences owned strictly by the authenticated user."
    },
    "/users/{userId}/parties/{partyId}": {
      "schema": { "$ref": "#/entities/Party" },
      "description": "Private customer and supplier Udhaar khata accounts owned by the merchant."
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Private daily cashbook and credit ledger entries owned by the merchant."
    },
    "/users/{userId}/cashDrawer/{drawerId}": {
      "schema": { "$ref": "#/entities/CashDrawer" },
      "description": "Physical note denomination tally for the merchant's cash drawer."
    }
  }
}
